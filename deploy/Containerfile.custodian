# Shared P6 JVM runtime: patched Temurin and OS CA trust, built/scanned/signed in infrastructure CI.
FROM ghcr.io/nusacred-lab/competency-proof-jvm-runtime@sha256:ecbcd98b260eac22078f57b46422999409094325a44d5f12e2f0b8ac6de90a89
USER 0:0
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/nusacred-lab/competency-proof"
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}"
LABEL org.nusacred.scope="synthetic-isolated-demo-only"
WORKDIR /app
RUN mkdir /data && chown 10001:10001 /data
COPY LICENSE /app/LICENSE
COPY custodian-backend/build/install/custodian-backend/lib/ /app/lib/
COPY custodian-backend/build/install/custodian-backend/native/ /app/native/
COPY web-portals/build/dist/wasmJs/productionExecutable/ /app/portals/
COPY web-portals/src/wasmJsMain/resources/ /app/portals/
COPY ci/prepare_portal_assets.sh /tmp/prepare_portal_assets.sh
RUN sh /tmp/prepare_portal_assets.sh /app/portals && rm /tmp/prepare_portal_assets.sh
USER 10001:10001
ENV HOME=/tmp HTTP_HOST=0.0.0.0 HTTP_PORT=8080 PORTAL_ROOT=/app/portals
EXPOSE 8080
ENTRYPOINT ["java", "-Dorg.sqlite.lib.path=/app/native", "-cp", "/app/lib/*", "id.nusacred.custodian.MainKt"]
